QLabel#titulo_principal_detalles, QLabel#titulo_crear_editar {
    margin-top: 1em;
    margin-bottom: 1em;
}

QWidget#tarjeta_menu {
    border: 1px solid #E0E0E0;
    border-radius: 12.5px;
}

QLabel#etiqueta_nombre_menu {
    font-weight: bold;
    font-size: 13pt;
}

QWidget#elemento_platillos {
    border-bottom: 2px solid #E0E0E0;
}

QTableWidget#tabla_detalles_platillos {
    border: 1px solid #E0E0E0;
    border-radius: 5px;
}

QPushButton#boton_agregar_platillo {
    margin-bottom: 0.5em;
}
